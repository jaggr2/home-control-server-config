# renovate: depName=cloudflare/cloudflared datasource=docker
[Unit]
Description=Cloudflare Tunnel
After=network-online.target

[Container]
Image=docker.io/cloudflare/cloudflared:2026.3.0
ContainerName=cloudflared
Network=host
Volume=%h/config/cloudflared:/home/nonroot/.cloudflared:Z
EnvironmentFile=%h/config/quadlets.env
# TUNNEL_TOKEN is provided via quadlets.env (cloudflared reads it directly)
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
