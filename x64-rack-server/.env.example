# Quadlet environment file
# Copy to: ~/config/quadlets.env  (referenced by .container files via EnvironmentFile)
# This file is gitignored — real values live only on the server.
# Podman's --env-file passes these directly to the container.

# Cloudflare Tunnel (cloudflared reads TUNNEL_TOKEN directly)
TUNNEL_TOKEN=your-tunnel-token-here

# Plex claim token (first run only — remove after claiming at https://plex.tv/claim)
PLEX_CLAIM=claim-xxxxxxxxxxxxxxxx

# Samba (dperson/samba)
USER=homelab;changeme
SHARE=shared;/shared;yes;no;no;homelab
SHARE2=media;/media;yes;no;yes
